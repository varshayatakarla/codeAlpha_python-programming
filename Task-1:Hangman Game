]


# ---------------- GAME FUNCTION ----------------

def play_game():

    # Set maximum incorrect attempts
    max_attempts = 6

    # Display game title
    print("\n===================================")
    print("          HANGMAN GAME")
    print("===================================")

    # Display difficulty options
    print("\nSelect Difficulty:")
    print("1. Easy")
    print("2. Medium")
    print("3. Hard")

    # Connect menu choices with difficulty levels
    difficulty_options = {
        "1": "easy",
        "2": "medium",
        "3": "hard"
    }

    # Ask the user to select difficulty
    while True:

        choice = input("\nEnter your choice (1-3): ").strip()

        if choice in difficulty_options:
            difficulty = difficulty_options[choice]
            break

        print("Invalid choice! Please select 1, 2 or 3.")

    # Randomly select a word and its hint
    secret_word, hint = random.choice(words[difficulty])

    # Store correctly guessed letters
    guessed_letters = []

    # Track incorrect guesses
    incorrect_guesses = 0

    # Track whether the hint is used
    hint_used = False

    print("\nGame started!")
    print("You have 6 incorrect attempts.")
    print("Type 'hint' whenever you need help.")

    # ---------------- MAIN GAME LOOP ----------------

    while incorrect_guesses < max_attempts:

        # Display the current Hangman stage
        print(hangman_stages[incorrect_guesses])

        # Display hidden and correctly guessed letters
        display_word = ""

        for letter in secret_word:

            if letter in guessed_letters:
                display_word += letter + " "

            else:
                display_word += "_ "

        print("Word:", display_word)

        # Display guessed letters
        print("Guessed letters:", guessed_letters)

        # Display remaining attempts
        print("Attempts remaining:",
              max_attempts - incorrect_guesses)

        # Check whether the user has guessed the complete word
        if all(letter in guessed_letters for letter in secret_word):

            print("\nCongratulations! You won!")

            # Calculate score
            score = (max_attempts - incorrect_guesses) * 10

            # Deduct marks if the hint was used
            if hint_used:
                score = max(0, score - 10)

            print("Your score:", score)
            return

        # Take a letter from the user
        guess = input("\nEnter a letter or type 'hint': ")
        guess = guess.lower().strip()

        # ---------------- HINT OPTION ----------------

        if guess == "hint":

            if hint_used:
                print("You have already used your hint!")

            else:
                print("Hint:", hint)
                hint_used = True

            continue

        # ---------------- INPUT VALIDATION ----------------

        # Accept only one alphabet
        if len(guess) != 1 or not guess.isalpha():

            print("Invalid input! Enter only one letter.")
            continue

        # Check whether the letter was already guessed
        if guess in guessed_letters:

            print("You already guessed this letter!")
            continue

        # Store the guessed letter
        guessed_letters.append(guess)

        # ---------------- CHECK GUESS ----------------

        if guess in secret_word:

            print("Correct guess!")

        else:

            incorrect_guesses += 1
            print("Wrong guess!")

    # ---------------- LOSING CONDITION ----------------

    print(hangman_stages[incorrect_guesses])

    print("\nGame Over!")
    print("The correct word was:", secret_word)
    print("Your score: 0")


# ---------------- MAIN PROGRAM ----------------

while True:

    # Start the game
    play_game()

    # Ask whether the user wants to play again
    print("\nWould you like to play again?")

    play_again = input("Enter yes or no: ").lower().strip()

    if play_again != "yes":

        print("\nThank you for playing Hangman!")
        print("See you again!")
        break
