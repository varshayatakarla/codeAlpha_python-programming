
import random

#--------------- WORD DATABASE ----------------

# Store words and hints according to difficulty levels
words = {
    "easy": [
        ("apple", "A fruit that keeps doctors away."),
        ("tiger", "A wild animal with black stripes."),
        ("mango", "A popular summer fruit.")
    ],

    "medium": [
        ("python", "A popular programming language."),
        ("flower", "A colorful part of a plant."),
        ("school", "A place where students learn.")
    ],

    "hard": [
        ("computer", "An electronic device used for processing data."),
        ("elephant", "The largest land animal.")
    ]
}


# ---------------- HANGMAN STAGES ----------------

# Display different Hangman stages based on wrong guesses
hangman_stages = [
    """
       -----
       |   |
           |
           |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
           |
